# Server Port
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# Supabase Configuration
# Obtain these from your Supabase project settings -> API
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Secret token to authorize external cron jobs (e.g., cron-job.org)
CRON_SECRET=supersecret_cron_token_change_me

# Target Mock Store Base URL
MOCK_STORE_URL=https://demo.inelabteamdev.com

# Scraper Settings
DEFAULT_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
